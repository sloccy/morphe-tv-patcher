<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps Wireless debugging switched on (and its pairing keys from expiring) and a few tracking
     settings off (Wi-Fi scanning, location, Play Protect uploads, crash reports, network
     recommendations): applied whenever tv-patcher starts the activity, at every boot, every 15
     minutes, and within seconds of Android switching Wireless debugging off, only when a value
     differs. No network access, no data. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sloccy.bootadb">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- granted over ADB by tv-patcher (pm grant); apps cannot get it any other way -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:label="TV settings helper"
        android:allowBackup="false"
        android:supportsRtl="false">

        <!-- Exported, but only to a caller holding WRITE_SECURE_SETTINGS: the adb shell has it and
             no app on the TV can get it, so only tv-patcher can trigger the settings. Plain
             exported="false" does not work: some TVs refuse the shell's `am start` of a
             non-exported activity ("not exported from uid"), even with START_ANY_ACTIVITY. Starting
             it also clears the app's "stopped" state so it can receive the boot broadcast. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".KeepOnJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".WatchJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
